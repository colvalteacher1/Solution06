
@using SharedModelsLib.Dto;
@model List<TeamDto>

@{
    ViewData["Title"] = "Ajouter un joueur";
}

@if(Model == null)
{
    <p class="badge bg-warning">Sport introuvable</p>
}
else
{
    
    <component type="typeof(MyBlazorLib.Components.Pages.AddPlayer)"
               render-mode="Server"
               param-Teams="Model" />
}

